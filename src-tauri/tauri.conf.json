{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Algorithm",
  "version": "2.0.0",
  "identifier": "com.pintapontus.algorithm",
  "build": {
    "frontendDist": "../dist/algorithm/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "bun run start",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Algorithm",
        "width": 1000,
        "height": 750,
        "resizable": true,
        "fullscreen": false,
        "minHeight": 750,
        "minWidth": 1000
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
